# Google Gemini API Key (used for multimodal video analysis & retention chart vision parsing)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Path to custom ffmpeg / ffprobe binaries (defaults to system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Retention Drop-off Threshold in % (defaults to 4.0)
DROPOFF_THRESHOLD_PCT=4.0
