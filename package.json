{
  "name": "retention-analyzer",
  "version": "1.0.0",
  "description": "Short-Form Video Retention & Editing Analyzer (A/B Outlier Engine) for TikTok and Instagram Reels",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "retention-analyzer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dryrun": "tsx src/index.ts --dry-run",
    "mocks": "tsx src/mocks/generateMocks.ts",
    "test": "tsx src/index.ts --dry-run"
  },
  "keywords": [
    "video-analytics",
    "retention-analysis",
    "tiktok",
    "instagram-reels",
    "ffmpeg",
    "gemini",
    "multimodal",
    "pacing"
  ],
  "author": "riccivr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riccivr/retention-analyzer.git"
  },
  "homepage": "https://github.com/riccivr/retention-analyzer#readme",
  "bugs": {
    "url": "https://github.com/riccivr/retention-analyzer/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ollama": "^0.6.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
